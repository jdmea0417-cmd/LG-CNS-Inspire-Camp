<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inspire.lgcns_mybatis.features.blog.repository.BlogMapper">

  <!-- listRow --> 

  <select id="listRow" resultType="BlogResponseDTO">
      SELECT  ID, TITLE, CONTENT, EMAIL
      FROM    BLOG_TBL
  </select>

  <!-- insertRow --> 

  <insert id="insertRow" parameterType="BlogRequestDTO">
    INSERT INTO BLOG_TBL
    VALUES(NEXTVAL(BLOG_SEQ), #{title}, #{content}, #{email})
  </insert>

  <!-- readRow --> 

  <select id="readRow" parameterType="java.lang.Integer" resultType="BlogResponseDTO">
    SELECT  ID, TITLE, CONTENT, EMAIL
    FROM    BLOG_TBL
    WHERE   ID = #{id}
  </select>  
</mapper>